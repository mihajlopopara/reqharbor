      },
      "expected": {
        "curl": "curl \\\n  'https://api.example.com/items' \\\n  -H 'Content-Type: application/json' \\\n  --data-raw ''"
      }
    },
    {
      "name": "xml",
      "request": {
        "id": "r",
        "method": "PUT",
        "url": "https://api.example.com/items",
        "body": {
          "type": "xml",
          "text": "<a it='s'/>"
        }
      },
      "expected": {
        "curl": "curl \\\n  -X PUT \\\n  'https://api.example.com/items' \\\n  -H 'Content-Type: application/xml' \\\n  --data-raw '<a it='\\''s'\\''/>'"
      }
    },
    {
      "name": "text-quotes-newlines",
      "request": {
        "id": "r",
        "method": "POST",
        "url": "https://api.example.com/items",
        "body": {
          "type": "text",
          "text": "it's\nline2 $HOME `x`"
        }
      },
      "expected": {
        "curl": "curl \\\n  'https://api.example.com/items' \\\n  -H 'Content-Type: text/plain' \\\n  --data-raw 'it'\\''s\nline2 $HOME `x`'"
      }
    },
    {
      "name": "graphql-variables-serde",
      "request": {
        "id": "r",
        "method": "POST",
        "url": "https://api.example.com/items",
        "body": {
          "type": "graphql",
          "graphql": {
            "query": "query Q($b: Int) { x }",
            "variables": "{\"z\": 1, \"a\": 1.0, \"big\": 18446744073709551615, \"neg\": -9223372036854775808, \"f\": 1e21, \"small\": 1e-7, \"x\": 100.50, \"u\": \"\\u00e9\\u0001/\\\"\", \"z\": [true, null, -0]}"
          }
        }
      },
      "expected": {
        "curl": "curl \\\n  'https://api.example.com/items' \\\n  -H 'Content-Type: application/json' \\\n  --data-raw '{\"query\":\"query Q($b: Int) { x }\",\"variables\":{\"z\":[true,null,-0.0],\"a\":1.0,\"big\":18446744073709551615,\"neg\":-9223372036854775808,\"f\":1e+21,\"small\":1e-7,\"x\":100.5,\"u\":\"é\\u0001/\\\"\"}}'"
      }
    },
    {
      "name": "graphql-float-formatting",
      "request": {
        "id": "r",
        "method": "POST",
        "url": "https://api.example.com/items",
        "body": {
          "type": "graphql",
          "graphql": {
            "query": "{ x }",
            "variables": "{\"n0\": 1e15,\"n1\": 1e16,\"n2\": 1e17,\"n3\": 1.5e16,\"n4\": 123456789012345680000.0,\"n5\": 1e20,\"n6\": 1e-5,\"n7\": 1e-6,\"n8\": 0.0001,\"n9\": 1.5e-7,\"n10\": 2.5e-300,\"n11\": 1.7976931348623157e308,\"n12\": 5e-324,\"n13\": 0.1,\"n14\": 123.456,\"n15\": -1.5e22,\"n16\": 1e300,\"n17\": 12345678901234567890123,\"n18\": 0.000001234,\"n19\": 1.0e0,\"n20\": 9007199254740993}"
          }
        }
      },
      "expected": {
        "curl": "curl \\\n  'https://api.example.com/items' \\\n  -H 'Content-Type: application/json' \\\n  --data-raw '{\"query\":\"{ x }\",\"variables\":{\"n0\":1000000000000000.0,\"n1\":1e+16,\"n2\":1e+17,\"n3\":1.5e+16,\"n4\":1.2345678901234567e+20,\"n5\":1e+20,\"n6\":0.00001,\"n7\":1e-6,\"n8\":0.0001,\"n9\":1.5e-7,\"n10\":2.5e-300,\"n11\":1.7976931348623157e+308,\"n12\":5e-324,\"n13\":0.1,\"n14\":123.456,\"n15\":-1.5e+22,\"n16\":1e+300,\"n17\":1.2345678901234568e+22,\"n18\":1.234e-6,\"n19\":1.0,\"n20\":9007199254740993}}'"
      }
    },
    {
      "name": "graphql-empty-variables",
      "request": {
        "id": "r",
        "method": "POST",
        "url": "https://api.example.com/items",
