{
  "$comment": "Shared cURL export parity fixtures (QA-R1-006). `expected` is generated by the Rust exporter: `docker compose run --rm -w /app/worker dev npm run parity:gen`. Consumed by worker/test/curl_parity.test.ts; the Rust side can load the same file.",
  "cases": [
    {
      "name": "get-headers",
      "request": {
        "id": "r",
        "method": "GET",
        "url": "https://api.example.com/items",
        "headers": [
          {
            "key": "Accept",
            "value": "application/json",
            "enabled": true
          },
          {
            "key": "X-Off",
            "value": "no",
            "enabled": false
          },
          {
            "key": "  X-Trim  ",
            "value": "v",
            "enabled": true
          },
          {
            "key": "X-Empty",
            "value": "",
            "enabled": true
          },
          {
            "key": "   ",
            "value": "ignored",
            "enabled": true
          }
        ]
      },
      "expected": {
        "curl": "curl \\\n  'https://api.example.com/items' \\\n  -H 'Accept: application/json' \\\n  -H 'X-Trim: v' \\\n  -H 'X-Empty;'"
      }
    },
    {
      "name": "params-rebuild-url",
      "request": {
        "id": "r",
        "method": "GET",
        "url": "https://api.example.com/items?stale=1#frag",
        "params": [
          {
            "key": "q",
            "value": "a b&c",
            "enabled": true
          },
          {
            "key": "off",
            "value": "x",
            "enabled": false
          },
          {
            "key": "k=y",
            "value": "#v",
            "enabled": true
          },
          {
            "key": "",
            "value": "",
            "enabled": true
          },
          {
            "key": "flag",
            "value": "",
            "enabled": true
          },
          {
            "key": "ü",
            "value": "é",
            "enabled": true
          }
        ]
      },
      "expected": {
        "curl": "curl \\\n  'https://api.example.com/items?q=a%20b%26c&k%3Dy=%23v&flag&%C3%BC=%C3%A9#frag'"
      }
    },
    {
      "name": "QA-R1-006a-brackets-globoff",
      "request": {
        "id": "r",
        "method": "GET",
        "url": "https://api.example.com/items?ids[]=1&ids[]=2"
      },
      "expected": {
        "curl": "curl \\\n  'https://api.example.com/items?ids[]=1&ids[]=2' \\\n  --globoff"
      }
    },
    {
      "name": "QA-R1-006a-keep-variables-globoff",
      "request": {
        "id": "r",
        "method": "GET",
        "url": "{{baseUrl}}/items"
      },
      "variables": [
        {
          "key": "baseUrl",
          "value": "https://staging.example.com",
          "enabled": true
        }
      ],
      "keepVariables": true,
      "expected": {
        "curl": "curl \\\n  '{{baseUrl}}/items' \\\n  --globoff"
      }
    },
    {
      "name": "variables-resolved-nested-depth",
      "request": {
        "id": "r",
        "method": "GET",
        "url": "{{a}}/x",
        "headers": [
          {
            "key": "X-Cycle",
            "value": "{{c1}}",
            "enabled": true
          },
          {
            "key": "X-Deep",
            "value": "{{d0}}",
            "enabled": true
          },
          {
            "key": "X-Unknown",
            "value": "{{ nope }}",
            "enabled": true
          }
        ]
      },
      "variables": [
        {
          "key": "a",
          "value": "{{b}}",
          "enabled": true
        },
        {
          "key": "b",
          "value": "{{c}}",
          "enabled": true
        },
        {
          "key": "c",
          "value": "{{d}}",
          "enabled": true
        },
        {
          "key": "d",
          "value": "https://deep.example.com",
          "enabled": true
        },
        {
          "key": "c1",
          "value": "x{{c2}}",
          "enabled": true
        },
        {
          "key": "c2",
          "value": "y{{c1}}",
          "enabled": true
        },
        {
          "key": "d0",
          "value": "{{d1}}",
          "enabled": true
        },
        {
          "key": "d1",
          "value": "{{d2}}",
          "enabled": true
        },
        {
          "key": "d2",
          "value": "{{d3}}",
          "enabled": true
        },
        {
          "key": "d3",
          "value": "{{d4}}",
          "enabled": true
        },
        {
          "key": "d4",
          "value": "end",
          "enabled": true
        }
      ],
      "expected": {
        "curl": "curl \\\n  'https://deep.example.com/x' \\\n  -H 'X-Cycle: {{c1}}' \\\n  -H 'X-Deep: {{d4}}' \\\n  -H 'X-Unknown: {{ nope }}'"
      }
    },
    {
      "name": "QA-R1-006b-head",
      "request": {
        "id": "r",
        "method": "HEAD",
        "url": "https://api.example.com/items"
      },
      "expected": {
        "curl": "curl \\\n  --head \\\n  'https://api.example.com/items'"
      }
    },
