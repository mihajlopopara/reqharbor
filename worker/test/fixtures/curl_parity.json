        "curl": "curl \\\n  'https://user@host.example.com:8443/p'"
      }
    },
    {
      "name": "scheme-ipv6-loopback",
      "request": {
        "id": "r",
        "method": "GET",
        "url": "[::1]:8080/p"
      },
      "expected": {
        "curl": "curl \\\n  'http://[::1]:8080/p' \\\n  --globoff"
      }
    },
    {
      "name": "custom-method",
      "request": {
        "id": "r",
        "method": "PURGE",
        "url": "https://api.example.com/items"
      },
      "expected": {
        "curl": "curl \\\n  -X PURGE \\\n  'https://api.example.com/items'"
      }
    },
    {
      "name": "method-trimmed",
      "request": {
        "id": "r",
        "method": "  DELETE ",
        "url": "https://api.example.com/items"
      },
      "expected": {
        "curl": "curl \\\n  -X DELETE \\\n  'https://api.example.com/items'"
      }
    },
    {
      "name": "invalid-method",
      "request": {
        "id": "r",
        "method": "post",
        "url": "https://api.example.com/items"
      },
      "expected": {
        "error": "Invalid method \"post\": use A–Z, 0–9, _ or -, starting with a letter"
      }
    },
    {
      "name": "empty-url",
      "request": {
        "id": "r",
        "method": "GET",
        "url": "   "
      },
      "expected": {
        "error": "URL is empty"
      }
    }
  ]
