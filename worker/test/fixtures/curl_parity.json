              "enabled": true
            },
            {
              "key": "",
              "value": "nokey",
              "kind": "text",
              "enabled": true
            },
            {
              "key": "off",
              "value": "x",
              "kind": "text",
              "enabled": false
            }
          ]
        }
      },
      "expected": {
        "curl": "curl \\\n  'https://api.example.com/items' \\\n  -F 'name=Ada' \\\n  -F 'typed=plain;type=text/csv' \\\n  --form-string 'a=x;type=text/html' \\\n  --form-string 'b=\"quoted\"' \\\n  --form-string 'at=@handle' \\\n  --form-string 'lt=<file' \\\n  -F 'doc=@\"/tmp/a;b,c.txt\"' \\\n  -F 'img=@/tmp/me.png;type=image/png' \\\n  -F 'q=@\"/tmp/x\\\"y\\\\z\"'"
